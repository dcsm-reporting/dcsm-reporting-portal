{
  "name": "dcsm-ki-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Washington DC South Mission — Key Indicators reporting portal. Cloudflare Workers + D1 + React.",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "wrangler dev",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "oracle": "python scripts/gen_oracle.py",
    "db:migrate:local": "wrangler d1 migrations apply dcsm_ki --local",
    "db:migrate:remote": "wrangler d1 migrations apply dcsm_ki --remote",
    "seed:local": "tsx scripts/seed_local.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "wrangler": "^3.95.0"
  }
}
